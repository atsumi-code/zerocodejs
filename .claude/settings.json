{
  "permissions": {
    "allow": ["Bash(npx vue-tsc *)", "Bash(npx vitest *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/type-check.sh\"",
            "timeout": 60,
            "statusMessage": "vue-tsc 型チェック中..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/related-tests.sh\"",
            "timeout": 60,
            "statusMessage": "関連する Vitest テストを実行中..."
          }
        ]
      }
    ]
  }
}
